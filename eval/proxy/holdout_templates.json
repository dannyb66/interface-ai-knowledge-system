        {
          "id": "h-asof-1",
          "text": "Looking back to {date}, which {attr} applied to {name}?"
        },
        {
          "id": "h-asof-2",
          "text": "Please use the information in effect on {date} to identify the {attr} for {name}."
        },
        {
          "id": "h-asof-3",
          "text": "I need the {attr} on {name} as it stood on {date}."
        }
      ],
      "forbid": [
        "balance_min",
        "balance_max"
      ]
    },
