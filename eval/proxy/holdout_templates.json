    "rate_current": {
      "kind": "current",
      "category": "current_value",
      "intent": "value",
      "templates": [
        {
          "id": "h-current-1",
          "text": "Please give me the latest published {attr} for {name}."
        },
        {
          "id": "h-current-2",
          "text": "For {name}, which {attr} should I use in a comparison today?"
        },
        {
          "id": "h-current-3",
          "text": "I am checking the terms on {name}; tell me its current {attr}."
        }
      ],
      "trap_category": "stale_trap",
      "forbid": [
        "balance_min",
        "balance_max"
      ]
    },
